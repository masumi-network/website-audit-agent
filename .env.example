# ── Sokosumi (required) ────────────────────────────────────────────────
# Preprod API base URL. Defaults to https://api.preprod.sokosumi.com if unset.
SOKOSUMI_API_URL=https://api.preprod.sokosumi.com

# Coworker API key from your Sokosumi coworker dashboard (required — worker exits without it).
SOKOSUMI_COWORKER_API_KEY=

# Credits to charge for a follow-up reply on a completed audit. Defaults to 5.
SOKOSUMI_TASK_CREDITS=5

# ── PageSpeed Insights (required for performance/SEO audits) ───────────
# Get a key at https://console.cloud.google.com (enable "PageSpeed Insights API").
PAGESPEED_API_KEY=

# ── Google service account (optional — enables GA4/GSC/GTM + Google Docs export) ─
# Path to the downloaded service account JSON key file.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=

# Drive folder ID to save generated Google Docs into (the folder must be shared
# with the service account email as Editor).
GOOGLE_DRIVE_FOLDER_ID=

# ── Google Analytics 4 (optional) ──────────────────────────────────────
GA4_PROPERTY_ID=
GA4_LOOKBACK_DAYS=30

# ── Google Search Console (optional) ───────────────────────────────────
GSC_SITE_URL=
GSC_LOOKBACK_DAYS=28

# ── Google Tag Manager (optional) ──────────────────────────────────────
GTM_ACCOUNT_ID=
GTM_CONTAINER_ID=

# ── Microsoft Clarity (optional) ───────────────────────────────────────
CLARITY_PROJECT_ID=
CLARITY_API_TOKEN=

# ── Local storage / misc (optional) ────────────────────────────────────
# Where weekly-diff audit snapshots are saved. Defaults to ./audit-history/
AUDIT_HISTORY_PATH=

# Path to a Chrome/Chromium binary, only needed if PDF export can't find Chrome automatically.
CHROME_PATH=
